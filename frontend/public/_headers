# ─── HTML 페이지 ───────────────────────────────────────
# no-store: 브라우저·CDN 어디에도 저장하지 않음 (배포 즉시 반영 보장)
/*
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0

# ─── Next.js 해시된 정적 파일 ──────────────────────────
# 파일명에 해시 포함 → 변경 시 새 URL → 영구 캐시 가능
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# ─── 공개 이미지/폰트 등 ────────────────────────────────
/images/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=86400
