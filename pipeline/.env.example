# ─── 인벤 크롤러 ─────────────────────────────────────────────────────────────
# 요청 시 서버에 전달할 User-Agent 문자열 (서버 부담 최소화를 위해 명시)
INVEN_USER_AGENT=legion-voice-tracker/0.1 (aion2-community-sentiment; contact: [이메일])

# 페이지 요청 간 대기 시간 (초). IP 차단 방지를 위해 3.0 이상 유지
INVEN_REQUEST_INTERVAL=3.0

# 수집 대상 게시판 ID 목록 (쉼표 구분)
# 6388=자유, 6444=팁과노하우, 6447=서버
INVEN_BOARD_IDS=6388,6444,6447

# ─── Gemini API ───────────────────────────────────────────────────────────────
# Google AI Studio(aistudio.google.com)에서 발급
GEMINI_API_KEY=

# 사용할 모델명. 무료 250 RPD 기준으로 gemini-2.5-flash 권장
GEMINI_MODEL=gemini-2.5-flash

# ─── Supabase ─────────────────────────────────────────────────────────────────
# 대시보드 → Project Settings → API → Project URL
SUPABASE_URL=

# 대시보드 → Project Settings → API → anon public key
# 프론트에서도 사용 가능한 공개 키 (RLS 정책으로 보호)
SUPABASE_ANON_KEY=

# 대시보드 → Project Settings → API → service_role secret key
# RLS를 우회하는 관리자 키 — 파이프라인 내부에서만 사용, 절대 외부 노출 금지
SUPABASE_SERVICE_ROLE_KEY=
