# 파이프라인 환경변수 템플릿 — `cp .env.example .env` 후 값 입력.
# .env는 .gitignore + pre-commit 훅으로 커밋이 차단된다. 실제 값은 여기 적지 말 것.
# GitHub Actions에서는 같은 이름의 Repository secrets로 주입된다 (.github/workflows/pipeline.yml).

# ─── 인벤 크롤러 ─────────────────────────────────────────────────────────────
# 요청 시 서버에 전달할 User-Agent 문자열 (서비스명·연락처 명시)
INVEN_USER_AGENT=legion-voice-tracker/0.1 (aion2-community-sentiment; contact: <your-email>)

# 페이지 요청 간 대기 시간 (초). IP 차단 방지를 위해 3.0 이상 유지
INVEN_REQUEST_INTERVAL=3.0

# 수집 대상 게시판 ID (쉼표 구분)
# 6388=자유, 6438=수호성, 6448=검성, 6449=살성, 6450=궁성,
# 6451=호법성, 6452=치유성, 6453=마도성, 6454=정령성
INVEN_BOARD_IDS=6388,6438,6448,6449,6450,6451,6452,6453,6454

# ─── 분류기 ──────────────────────────────────────────────────────────────────
# hybrid(기본) | gemini | local | transformer — src/config.py 주석 참고
CLASSIFIER_MODE=hybrid

# hybrid 모드에서 실행 1회당 Gemini 호출 상한 (무료 RPD 보호)
GEMINI_CALLS_PER_RUN=12

# ─── Gemini API (비밀) ───────────────────────────────────────────────────────
# Google AI Studio(aistudio.google.com)에서 발급
GEMINI_API_KEY=<your-gemini-api-key>

# 1순위 모델. 실패 시 src/processors/classifier.py의 폴백 체인 순서로 시도
GEMINI_MODEL=gemini-2.5-flash-lite

# ─── Supabase ─────────────────────────────────────────────────────────────────
# 대시보드 → Project Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# anon(public) 키 — 프론트 번들에도 들어가는 공개 키. 보호는 RLS가 담당
SUPABASE_ANON_KEY=<your-anon-key>

# service_role 키 (비밀) — RLS를 우회하는 관리자 키. 파이프라인 내부 전용, 절대 외부 노출 금지
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
